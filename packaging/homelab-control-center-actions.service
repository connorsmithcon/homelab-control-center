[Unit]
Description=Homelab Control Center privileged action broker
Documentation=https://github.com/connorsmithcon/homelab-control-center
Requires=homelab-control-center-actions.socket
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/homelab-control-center/current/src/actiond.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal
